# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=1

# ---------------------------------------------------------------------------
# Storage (relative paths are resolved against the project root)
# ---------------------------------------------------------------------------
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
INDEX_DIR=storage/indexes
DATABASE_PATH=storage/semantic_search.db
LOG_DIR=storage/logs

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,txt

# ---------------------------------------------------------------------------
# Chunking (characters; overlap must be smaller than chunk size)
# ---------------------------------------------------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Production/default: real semantic embeddings on CPU.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=storage/models
EMBEDDING_DIMENSION=384

# Offline fallback only (not semantically intelligent): uncomment if PyTorch
# native DLLs cannot be loaded on your machine.
# EMBEDDING_BACKEND=hashing

# ---------------------------------------------------------------------------
# Vector index: auto | faiss | numpy
#   auto  -> use FAISS when importable, otherwise exact NumPy fallback
#   faiss -> fail at startup if FAISS is unavailable
#   numpy -> force the portable exact inner-product fallback
# ---------------------------------------------------------------------------
VECTOR_BACKEND=auto

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------
TOP_K_DEFAULT=5
TOP_K_MAX=20
MAX_QUERY_LENGTH=1000
